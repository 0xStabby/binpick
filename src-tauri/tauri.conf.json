{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "binpick",
  "version": "0.1.0",
  "identifier": "com.stabby.binpick",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "binpick",
        "width": 720,
        "height": 440,
        "center": true,
        "resizable": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$DATA/icons/**",
            "$DATA/pixmaps/**",
            "/usr/share/icons/**",
            "/usr/share/pixmaps/**",
            "/usr/local/share/icons/**",
            "/usr/local/share/pixmaps/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
